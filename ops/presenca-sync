#!/usr/bin/env bash
set -euo pipefail

BASE=/app/presenca
SRC="$BASE/repository"
STORAGE="$BASE/storage"
STATE="$BASE/.deployed-sha"
LOG="$BASE/sync.log"
REPO_URL=https://github.com/mskpoeira/presenca.git
BRANCH=main
APP=presenca-app
CANDIDATE=presenca-candidate
NETWORK=presenca
BIND=${PRESENCA_BIND:-127.0.0.1:58080}

mkdir -p "$BASE" "$STORAGE"
exec 9>"$BASE/.sync.lock"
flock -n 9 || exit 0
exec >>"$LOG" 2>&1

if [ ! -d "$SRC/.git" ]; then
  rm -rf "$SRC"
  git clone --depth 1 --branch "$BRANCH" "$REPO_URL" "$SRC"
else
  git -C "$SRC" fetch --depth 1 origin "$BRANCH"
fi

NEW_SHA=$(git -C "$SRC" rev-parse "origin/$BRANCH")
OLD_SHA=$(cat "$STATE" 2>/dev/null || true)

if [ "$NEW_SHA" = "$OLD_SHA" ] && docker inspect "$APP" >/dev/null 2>&1; then
  if docker exec "$APP" php -r 'exit(@file_get_contents("http://127.0.0.1/")===false?1:0);' >/dev/null 2>&1; then
    exit 0
  fi
fi

git -C "$SRC" reset --hard "origin/$BRANCH"
IMAGE="presenca-app:$NEW_SHA"

docker network inspect "$NETWORK" >/dev/null 2>&1 || docker network create "$NETWORK" >/dev/null
docker build --pull=false -t "$IMAGE" "$SRC"

chown -R 33:33 "$STORAGE" || true
chmod -R u+rwX,g+rwX,o-rwx "$STORAGE" || true

docker rm -f "$CANDIDATE" >/dev/null 2>&1 || true
docker run -d --name "$CANDIDATE" --restart no   --network "$NETWORK"   -e PRESENCA_STORAGE=/var/www/storage   -v "$STORAGE:/var/www/storage"   "$IMAGE" >/dev/null

for i in $(seq 1 30); do
  if docker exec "$CANDIDATE" php -r 'exit(@file_get_contents("http://127.0.0.1/")===false?1:0);' >/dev/null 2>&1; then
    break
  fi
  [ "$i" -lt 30 ] || { docker logs --tail 120 "$CANDIDATE"; exit 1; }
  sleep 1
done

OLD_IMAGE=$(docker inspect "$APP" --format '{{.Config.Image}}' 2>/dev/null || true)
docker rm -f "$APP" >/dev/null 2>&1 || true
docker rm -f "$CANDIDATE" >/dev/null 2>&1 || true

docker run -d --name "$APP" --restart always   --network "$NETWORK"   -p "$BIND:80"   -e PRESENCA_STORAGE=/var/www/storage   -v "$STORAGE:/var/www/storage"   "$IMAGE" >/dev/null

POST_OK=no
for i in $(seq 1 20); do
  if docker exec "$APP" php -r 'exit(@file_get_contents("http://127.0.0.1/")===false?1:0);' >/dev/null 2>&1; then
    POST_OK=yes
    break
  fi
  sleep 2
done

if [ "$POST_OK" != "yes" ]; then
  docker rm -f "$APP" >/dev/null 2>&1 || true
  if [ -n "$OLD_IMAGE" ]; then
    docker run -d --name "$APP" --restart always       --network "$NETWORK"       -p "$BIND:80"       -e PRESENCA_STORAGE=/var/www/storage       -v "$STORAGE:/var/www/storage"       "$OLD_IMAGE" >/dev/null
  fi
  exit 1
fi

printf '%s
' "$NEW_SHA" > "$STATE"
docker tag "$IMAGE" presenca-app:latest
docker image prune -f >/dev/null 2>&1 || true
